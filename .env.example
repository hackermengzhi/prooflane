# Optional: explicit LLM planning. No .env file is loaded automatically.
# For provider tables, reasoning effort and retries use PROOFLANE_CONFIG (see examples/model-config.toml).
# Set these variables in your shell or process environment.
# Full endpoint URL ending in /chat/completions (Chat Completions) or /responses (Responses API).
PROOFLANE_LLM_URL=https://api.openai.com/v1/chat/completions
PROOFLANE_LLM_MODEL=your-model-id
PROOFLANE_LLM_API_KEY=your-api-key
