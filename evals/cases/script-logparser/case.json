      "hidden_test.LogParserAcceptance.test_filters_status_ranges_inclusively",
      "hidden_test.LogParserAcceptance.test_writes_deterministic_json_to_output",
      "hidden_test.LogParserAcceptance.test_skips_and_reports_malformed_lines",
      "hidden_test.LogParserAcceptance.test_reports_invalid_lines_before_status_filtering",
      "hidden_test.LogParserAcceptance.test_empty_and_invalid_only_inputs",
      "hidden_test.LogParserAcceptance.test_missing_input_exits_2",
      "hidden_test.LogParserAcceptance.test_invalid_status_filter_exits_2"
    ]
  }
